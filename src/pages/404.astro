---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Không tìm thấy trang — Ngọc Rồng Online" description="Trang bạn tìm không tồn tại.">
  <SiteHeader />
  <main id="noi-dung" class="py-20 text-center">
    <div class="container-x">
      <p class="font-display text-6xl font-bold text-primary">404</p>
      <h1 class="mt-2 text-3xl font-bold md:text-4xl">Không tìm thấy trang này</h1>
      <p class="mt-3 text-muted-foreground">Đường dẫn có thể đã bị đổi hoặc gõ sai.</p>
      <a href="/" class="btn btn-primary mt-6">Về trang chủ</a>
    </div>
  </main>
  <Footer />
</Base>
