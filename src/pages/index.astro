---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Planets from '../components/Planets.astro';
import Onboarding from '../components/Onboarding.astro';
import NewsCommunity from '../components/NewsCommunity.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { downloads } from '../data/links';
---
<Base title="Cộng đồng Ngọc Rồng Online — Hướng dẫn tân thủ & link tải chính thức" description="Trang cộng đồng (không chính thức) giúp người mới chọn hành tinh, làm quen game và vào nhóm Zalo, Discord, Telegram.">
  <div class="bg-foreground px-4 py-2 text-center text-sm font-semibold text-footer-text">
    Trang cộng đồng, không phải trang chính thức. Không bao giờ yêu cầu mật khẩu hay nạp tiền.
  </div>
  <header class="border-b-2 border-foreground bg-background">
    <nav class="container-x flex min-h-14 items-center justify-between gap-4" aria-label="Điều hướng chính">
      <a href="/" class="inline-flex min-h-11 items-center font-display text-xl font-bold no-underline">Ngọc Rồng · Cộng đồng</a>
      <ul class="hidden items-center gap-6 font-bold md:flex">
        <li><a class="inline-flex min-h-11 items-center hover:underline underline-offset-4" href="#hanh-tinh">Hành tinh</a></li>
        <li><a class="inline-flex min-h-11 items-center hover:underline underline-offset-4" href="#tan-thu">Tân thủ</a></li>
        <li><a class="inline-flex min-h-11 items-center hover:underline underline-offset-4" href="#faq">Hỏi đáp</a></li>
        <li><a class="inline-flex min-h-11 items-center hover:underline underline-offset-4" href="#cong-dong">Cộng đồng</a></li>
      </ul>
    </nav>
  </header>

  <main id="noi-dung">
    <Hero />
    <Planets />
    <Onboarding />
    <NewsCommunity />
  </main>
  <Footer />

  <div id="sticky-dl" class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t-2 border-foreground bg-background p-3 transition-transform duration-200 md:hidden" aria-hidden="true">
    <a id="sticky-link" href={downloads.pc.url} tabindex="-1" class="btn btn-primary w-full" target="_blank" rel="noopener noreferrer"><Icon name="download" /> Tải game</a>
  </div>
  <script>
    // Thanh tải cố định trên mobile: chỉ hiện khi nút hero đã cuộn khỏi màn hình
    const main = document.getElementById('dl-main') as HTMLAnchorElement | null;
    const bar = document.getElementById('sticky-dl');
    const link = document.getElementById('sticky-link') as HTMLAnchorElement | null;
    if (main && bar && link && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        const show = !e.isIntersecting;
        bar.classList.toggle('translate-y-full', !show);
        bar.setAttribute('aria-hidden', String(!show));
        link.tabIndex = show ? 0 : -1;
        link.href = main.href;
      }).observe(main);
    }
  </script>
</Base>
