---
import Icon from './Icon.astro';
import { news } from '../data/content';
import { community } from '../data/links';
const icons: Record<string, string> = { zalo: 'chat', discord: 'headset', telegram: 'send' };
const fmt = (d: string) => new Date(d).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
---
<section id="cong-dong" class="py-16 md:py-24">
  <div class="container-x grid gap-12 lg:grid-cols-[1.2fr_1fr]">
    <div>
      <h2 class="section-title reveal">Sự kiện &amp; tin tức</h2>
      <ul class="mt-6 space-y-3">
        {news.map((n) => (
          <li class="reveal rounded-card border-2 border-border bg-card p-5">
            <div class="flex flex-wrap items-center gap-2 text-sm">
              <span class="rounded-full bg-accent px-3 py-0.5 font-bold text-foreground">{n.tag}</span>
              <time datetime={n.date} class="text-muted-foreground">{fmt(n.date)}</time>
            </div>
            <h3 class="mt-2 text-xl font-bold">{n.title}</h3>
            <p class="text-muted-foreground">{n.text}</p>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="section-title reveal">Vào cộng đồng</h2>
      <ul class="mt-6 space-y-3">
        {community.map((c) => (
          <li class="reveal">
            <a href={c.url} target="_blank" rel="noopener noreferrer" class="flex min-h-[64px] items-center gap-4 rounded-card border-2 border-foreground bg-card p-4 shadow-card no-underline transition-transform hover:-translate-y-0.5">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-secondary text-white"><Icon name={icons[c.id]} /></span>
              <span class="flex-1">
                <span class="block font-display text-xl font-bold">{c.name}</span>
                <span class="block text-base text-muted-foreground">{c.desc}</span>
              </span>
              <span class="inline-flex items-center gap-1 font-bold text-secondary">Tham gia <Icon name="external" class="h-4 w-4" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
