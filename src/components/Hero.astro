---
import Icon from './Icon.astro';
import { downloads } from '../data/links';
---
<section class="relative overflow-hidden border-b-2 border-foreground" style="background: linear-gradient(160deg, #fdba74 0%, #fde68a 100%);">
  <div class="container-x grid gap-6 py-10 md:grid-cols-[1.2fr_1fr] md:items-center md:gap-10 md:py-12 lg:py-14">
    <div>
      <p class="inline-block rounded-full bg-card border-2 border-foreground px-3 py-1 text-sm font-bold">Ngọc Rồng Online</p>
      <h1 class="mt-4 text-[2.25rem] font-bold sm:text-5xl lg:text-6xl">Bắt đầu hành trình Ngọc Rồng của bạn</h1>
      <p class="mt-4 max-w-[34rem] text-lg">Tải game, chọn hành tinh và nhận ưu đãi sự kiện mới nhất. Làm quen chỉ trong vài bước.</p>

      <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a id="dl-main" href={downloads.pc.url} class="btn btn-primary" data-android={downloads.android.url} data-ios={downloads.ios.url} data-pc={downloads.pc.url} target="_blank" rel="noopener noreferrer">
          <Icon name="download" /> <span id="dl-label">Tải game</span>
        </a>
        <a href="#uu-dai" class="btn btn-secondary bg-card">Xem ưu đãi</a>
      </div>
      <p id="dl-note" class="mt-3 min-h-6 text-sm font-semibold" role="status" aria-live="polite"></p>

      <p class="mt-1 text-sm text-muted-foreground">
        Nền tảng khác:{' '}
        <a class="font-bold text-foreground underline underline-offset-2" href={downloads.android.url}>Android</a> ·
        <a class="font-bold text-foreground underline underline-offset-2" href={downloads.ios.url}>iPhone</a> ·
        <a class="font-bold text-foreground underline underline-offset-2" href={downloads.pc.url}>Windows</a>
      </p>
    </div>

    <div class="mx-auto w-full max-w-[18rem] sm:max-w-sm md:max-w-[26rem] md:justify-self-end" aria-hidden="true">
      <svg viewBox="0 0 400 400" class="h-auto w-full" role="img" aria-hidden="true" focusable="false">
        <defs>
          <radialGradient id="hero-glow" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#fff" stop-opacity=".85"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></radialGradient>
        </defs>
        <circle cx="200" cy="200" r="190" fill="url(#hero-glow)"/>
        <circle cx="200" cy="200" r="150" fill="none" stroke="#2a1708" stroke-opacity=".18" stroke-width="2" stroke-dasharray="3 8"/>

        <!-- Rồng bay (thiết kế gốc: sapphire + vàng) -->
        <g class="bob" stroke-linecap="round" stroke-linejoin="round" fill="none">
          <g stroke="#2a1708"><path d="M40 330 C 40 282, 100 272, 140 286" stroke-width="24"/><path d="M140 286 C 190 304, 230 262, 235 222" stroke-width="36"/><path d="M235 222 C 240 172, 300 178, 315 132" stroke-width="46"/><path d="M315 132 C 325 98, 292 78, 272 62" stroke-width="50"/></g>
          <g stroke="#1d4ed8"><path d="M40 330 C 40 282, 100 272, 140 286" stroke-width="16"/><path d="M140 286 C 190 304, 230 262, 235 222" stroke-width="28"/><path d="M235 222 C 240 172, 300 178, 315 132" stroke-width="38"/><path d="M315 132 C 325 98, 292 78, 272 62" stroke-width="42"/></g>
          <g stroke="#fde68a" stroke-dasharray="3 9" opacity=".95"><path d="M40 330 C 40 282, 100 272, 140 286" stroke-width="2"/><path d="M140 286 C 190 304, 230 262, 235 222" stroke-width="10"/><path d="M235 222 C 240 172, 300 178, 315 132" stroke-width="20"/><path d="M315 132 C 325 98, 292 78, 272 62" stroke-width="24"/></g>
          <!-- lửa ở đuôi -->
          <path d="M40 330 C 18 322, 14 300, 26 288 C 28 304, 40 310, 46 316 C 48 322, 44 326, 40 330Z" fill="#fbbf24" stroke="#2a1708" stroke-width="3.5"/>
          <!-- bờm kem sau đầu -->
          <g fill="#fff7ed" stroke="#2a1708" stroke-width="3.5">
            <path d="M290 92 C 318 96, 340 84, 346 62 C 330 70, 318 66, 312 56 C 306 74, 296 82, 290 92Z"/>
            <path d="M300 118 C 328 124, 352 112, 358 90 C 340 98, 328 94, 322 84 C 316 102, 306 110, 300 118Z"/>
          </g>
          <!-- sừng vàng -->
          <path d="M280 48 Q 304 22, 330 30" stroke="#2a1708" stroke-width="11"/>
          <path d="M280 48 Q 304 22, 330 30" stroke="#fbbf24" stroke-width="5"/>
          <path d="M270 44 Q 284 16, 312 10" stroke="#2a1708" stroke-width="11"/>
          <path d="M270 44 Q 284 16, 312 10" stroke="#fbbf24" stroke-width="5"/>
          <!-- đầu -->
          <ellipse cx="250" cy="57" rx="37" ry="23" transform="rotate(-18 250 57)" fill="#1d4ed8" stroke="#2a1708" stroke-width="4"/>
          <path d="M224 60 Q 240 74 262 70" stroke="#fde68a" stroke-width="4"/>
          <circle cx="266" cy="48" r="7.5" fill="#fbbf24" stroke="#2a1708" stroke-width="2.5"/>
          <circle cx="267" cy="48" r="3" fill="#2a1708"/>
          <circle cx="226" cy="52" r="2.2" fill="#2a1708"/>
          <!-- râu vàng -->
          <path d="M226 58 Q 196 76 176 56" stroke="#fbbf24" stroke-width="3"/>
          <path d="M228 52 Q 200 34 172 40" stroke="#fbbf24" stroke-width="3"/>
        </g>

        <!-- 7 viên ngọc pha lê xoay quanh -->
        <g class="drift" style="transform-box: fill-box;">
          <g transform="translate(200.0 50.0)">
            <circle r="25" fill="#ef4444" stroke="#2a1708" stroke-width="3.5"/>
            <path d="M-25 2 Q0 -19 25 2" fill="none" stroke="#fbbf24" stroke-width="3" opacity=".9"/>
            <ellipse cx="-7" cy="-8" rx="7" ry="4" fill="#fff" opacity=".75" transform="rotate(-30 -7 -8)"/>
          </g>
          <g transform="translate(317.3 106.5)">
            <circle r="25" fill="#f97316" stroke="#2a1708" stroke-width="3.5"/>
            <path d="M-25 2 Q0 -19 25 2" fill="none" stroke="#fbbf24" stroke-width="3" opacity=".9"/>
            <ellipse cx="-7" cy="-8" rx="7" ry="4" fill="#fff" opacity=".75" transform="rotate(-30 -7 -8)"/>
          </g>
          <g transform="translate(346.2 233.4)">
            <circle r="25" fill="#facc15" stroke="#2a1708" stroke-width="3.5"/>
            <path d="M-25 2 Q0 -19 25 2" fill="none" stroke="#fbbf24" stroke-width="3" opacity=".9"/>
            <ellipse cx="-7" cy="-8" rx="7" ry="4" fill="#fff" opacity=".75" transform="rotate(-30 -7 -8)"/>
          </g>
          <g transform="translate(265.1 335.1)">
            <circle r="25" fill="#22c55e" stroke="#2a1708" stroke-width="3.5"/>
            <path d="M-25 2 Q0 -19 25 2" fill="none" stroke="#fbbf24" stroke-width="3" opacity=".9"/>
            <ellipse cx="-7" cy="-8" rx="7" ry="4" fill="#fff" opacity=".75" transform="rotate(-30 -7 -8)"/>
          </g>
          <g transform="translate(134.9 335.1)">
            <circle r="25" fill="#06b6d4" stroke="#2a1708" stroke-width="3.5"/>
            <path d="M-25 2 Q0 -19 25 2" fill="none" stroke="#fbbf24" stroke-width="3" opacity=".9"/>
            <ellipse cx="-7" cy="-8" rx="7" ry="4" fill="#fff" opacity=".75" transform="rotate(-30 -7 -8)"/>
          </g>
          <g transform="translate(53.8 233.4)">
            <circle r="25" fill="#3b82f6" stroke="#2a1708" stroke-width="3.5"/>
            <path d="M-25 2 Q0 -19 25 2" fill="none" stroke="#fbbf24" stroke-width="3" opacity=".9"/>
            <ellipse cx="-7" cy="-8" rx="7" ry="4" fill="#fff" opacity=".75" transform="rotate(-30 -7 -8)"/>
          </g>
          <g transform="translate(82.7 106.5)">
            <circle r="25" fill="#8b5cf6" stroke="#2a1708" stroke-width="3.5"/>
            <path d="M-25 2 Q0 -19 25 2" fill="none" stroke="#fbbf24" stroke-width="3" opacity=".9"/>
            <ellipse cx="-7" cy="-8" rx="7" ry="4" fill="#fff" opacity=".75" transform="rotate(-30 -7 -8)"/>
          </g>
        </g>
      </svg>
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById('dl-main') as HTMLAnchorElement | null;
  const label = document.getElementById('dl-label');
  const note = document.getElementById('dl-note');
  if (btn && label) {
    const ua = navigator.userAgent;
    const isIOS = /iPhone|iPad|iPod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    const isAndroid = /Android/i.test(ua);
    const d = btn.dataset;
    if (isAndroid) { btn.href = d.android!; label.textContent = 'Tải cho Android'; }
    else if (isIOS) { btn.href = d.ios!; label.textContent = 'Tải cho iPhone'; }
    else if (/Windows/i.test(ua)) { btn.href = d.pc!; label.textContent = 'Tải cho Windows'; }
  }
  // Link chưa cấu hình: báo rõ thay vì dẫn đi đâu đó
  document.querySelectorAll<HTMLAnchorElement>('a[href="#"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      if (note) note.textContent = 'Link tải sẽ được cập nhật sớm.';
    });
  });
</script>
