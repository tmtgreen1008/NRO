---
import Icon from './Icon.astro';
import { downloads } from '../data/links';
---
<section class="relative overflow-hidden border-b-2 border-foreground" style="background: linear-gradient(160deg, #fdba74 0%, #fde68a 100%);">
  <div class="container-x grid gap-6 py-10 md:grid-cols-[1.2fr_1fr] md:items-center md:gap-10 md:py-12 lg:py-14">
    <div>
      <p class="inline-block rounded-full bg-card border-2 border-foreground px-3 py-1 text-sm font-bold">Ngọc Rồng Online</p>
      <h1 class="mt-4 text-[2.25rem] font-bold sm:text-5xl lg:text-6xl">Bắt đầu hành trình Ngọc Rồng của bạn</h1>
      <p class="mt-4 max-w-[34rem] text-lg">Tải game, chọn hành tinh và nhận ưu đãi sự kiện mới nhất. Làm quen chỉ trong vài bước.</p>

      <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a id="dl-main" href={downloads.pc.url} class="btn btn-primary" data-android={downloads.android.url} data-ios={downloads.ios.url} data-pc={downloads.pc.url} target="_blank" rel="noopener noreferrer">
          <Icon name="download" /> <span id="dl-label">Tải game</span>
        </a>
        <a href="#uu-dai" class="btn btn-secondary bg-card">Xem ưu đãi</a>
      </div>
      <p id="dl-note" class="mt-3 min-h-6 text-sm font-semibold" role="status" aria-live="polite"></p>

      <p class="mt-1 text-sm text-muted-foreground">
        Nền tảng khác:{' '}
        <a class="font-bold text-foreground underline underline-offset-2" href={downloads.android.url}>Android</a> ·
        <a class="font-bold text-foreground underline underline-offset-2" href={downloads.ios.url}>iPhone</a> ·
        <a class="font-bold text-foreground underline underline-offset-2" href={downloads.pc.url}>Windows</a>
      </p>
    </div>

    <div class="mx-auto w-full max-w-[20rem] sm:max-w-sm md:max-w-[26rem] md:justify-self-end">
      <img
        src="/images/hero-main.webp" width="900" height="1125"
        alt="Hạo, nhân vật của game, đứng giữa biển lửa với con rồng xanh sapphire phía sau và bảy viên ngọc pha lê đủ màu phía trước."
        fetchpriority="high" decoding="async"
        class="block h-auto w-full rounded-card border-2 border-foreground shadow-card"
      />
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById('dl-main') as HTMLAnchorElement | null;
  const label = document.getElementById('dl-label');
  const note = document.getElementById('dl-note');
  if (btn && label) {
    const ua = navigator.userAgent;
    const isIOS = /iPhone|iPad|iPod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    const isAndroid = /Android/i.test(ua);
    const d = btn.dataset;
    if (isAndroid) { btn.href = d.android!; label.textContent = 'Tải cho Android'; }
    else if (isIOS) { btn.href = d.ios!; label.textContent = 'Tải cho iPhone'; }
    else if (/Windows/i.test(ua)) { btn.href = d.pc!; label.textContent = 'Tải cho Windows'; }
  }
  // Link chưa cấu hình: báo rõ thay vì dẫn đi đâu đó
  document.querySelectorAll<HTMLAnchorElement>('a[href="#"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      if (note) note.textContent = 'Link tải sẽ được cập nhật sớm.';
    });
  });
</script>
