---
import Icon from './Icon.astro';
import { steps, faqs } from '../data/content';
---
<section id="tan-thu" class="border-y-2 border-foreground bg-card py-16 md:py-24">
  <div class="container-x">
    <h2 class="section-title reveal">Tân thủ trong 5 bước</h2>

    <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {steps.map((s, i) => (
        <li class="reveal rounded-card border-2 border-border bg-background p-5">
          <span class="flex items-center justify-between">
            <span class="grid h-12 w-12 place-items-center rounded-full bg-accent text-foreground border-2 border-foreground"><Icon name={s.icon} /></span>
            <span class="font-display text-3xl font-bold text-muted-foreground" aria-hidden="true">{i + 1}</span>
          </span>
          <h3 class="mt-3 text-xl font-bold"><span class="sr-only">Bước {i + 1}: </span>{s.title}</h3>
          <p class="mt-1 text-base text-muted-foreground">{s.text}</p>
        </li>
      ))}
    </ol>

    <h2 id="faq" class="section-title reveal mt-16">Câu hỏi thường gặp</h2>
    <div class="mt-6 max-w-3xl space-y-3">
      {faqs.map((f) => (
        <details class="group reveal rounded-card border-2 border-border bg-background open:border-foreground">
          <summary class="flex min-h-[52px] cursor-pointer list-none items-center justify-between gap-4 px-5 py-3 font-bold [&::-webkit-details-marker]:hidden">
            <span>{f.q}</span>
            <Icon name="chevron" class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180" />
          </summary>
          <p class="px-5 pb-4 text-muted-foreground">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
