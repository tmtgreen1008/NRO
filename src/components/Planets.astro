---
import Icon from './Icon.astro';
import PlanetArt from './art/PlanetArt.astro';
import { planets } from '../data/content';
const bg: Record<string, string> = { earth: 'bg-earth', namek: 'bg-namek', xayda: 'bg-xayda' };
---
<section id="hanh-tinh" class="py-16 md:py-24">
  <div class="container-x">
    <h2 class="section-title reveal">Chọn hành tinh của bạn</h2>
    <p class="reveal mt-2 max-w-2xl text-muted-foreground">Mỗi hành tinh có lối chơi riêng. Chạm vào một thẻ để xem chi tiết.</p>

    <div class="mt-8 grid gap-4 md:grid-cols-3" role="group" aria-label="Danh sách hành tinh" id="planet-list">
      {planets.map((p, i) => (
        <button type="button" data-planet={p.id} aria-pressed={i === 0 ? 'true' : 'false'}
          class="planet-card reveal text-left rounded-card border-2 border-foreground bg-card shadow-card overflow-hidden transition-transform duration-200 hover:-translate-y-1 cursor-pointer aria-pressed:shadow-block aria-pressed:-translate-y-1">
          <span class="block border-b-2 border-foreground"><PlanetArt kind={p.color as 'earth' | 'namek' | 'xayda'} /></span>
          <span class={`flex items-center gap-3 px-5 py-4 text-white ${bg[p.color]}`}>
            <Icon name="planet" class="w-9 h-9" />
            <span class="font-display text-2xl font-bold">{p.name}</span>
          </span>
          <span class="block px-5 py-4">
            <span class="block text-sm font-bold text-muted-foreground">{p.race}</span>
            <span class="mt-1 block font-semibold">{p.tagline}</span>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-bold text-secondary">
              <span class="planet-state">{i === 0 ? 'Đang xem' : 'Xem chi tiết'}</span>
            </span>
          </span>
        </button>
      ))}
    </div>

    <div id="planet-detail" class="mt-6 rounded-card border-2 border-foreground bg-card p-6 shadow-card" aria-live="polite">
      {planets.map((p, i) => (
        <div data-detail={p.id} hidden={i !== 0}>
          <h3 class="text-2xl font-bold">{p.name} — {p.race}</h3>
          <ul class="mt-3 grid gap-2 sm:grid-cols-3">
            {p.traits.map((t) => (
              <li class="flex items-start gap-2"><Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-namek" /> <span>{t}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const cards = document.querySelectorAll<HTMLButtonElement>('.planet-card');
  const details = document.querySelectorAll<HTMLElement>('[data-detail]');
  cards.forEach((c) => c.addEventListener('click', () => {
    cards.forEach((o) => {
      const on = o === c;
      o.setAttribute('aria-pressed', String(on));
      const s = o.querySelector('.planet-state');
      if (s) s.textContent = on ? 'Đang xem' : 'Xem chi tiết';
    });
    details.forEach((d) => (d.hidden = d.dataset.detail !== c.dataset.planet));
  }));
</script>
